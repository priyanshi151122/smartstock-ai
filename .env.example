-- SmartStock AI — copy to .env and adjust as needed.
-- Never commit a filled-in .env file with real secrets.

# ---------------------------------------------------------------- application
APP_NAME=SmartStock AI
APP_VERSION=1.0.0
ENVIRONMENT=development

# -------------------------------------------------------------------- storage
# Relative paths resolve from the project root. Swap to PostgreSQL when ready:
#   DATABASE_URL=postgresql://smartstock:password@localhost:5432/smartstock
DATABASE_URL=sqlite:///./data/smartstock.db
DATA_DIR=./data

# -------------------------------------------------------------------- uploads
MAX_UPLOAD_MB=10
MAX_UPLOAD_ROWS=200000

# ---------------------------------------------------------------- forecasting
MIN_HISTORY_DAYS_FOR_ML=42
DEFAULT_HORIZON_DAYS=14
DEFAULT_MODEL=auto
SERVICE_LEVEL_Z=1.65

# --------------------------------------------------------------------- server
# Comma-separated list of allowed browser origins for the dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
SERVE_FRONTEND=true

# Frontend build-time variables live in frontend/.env (see frontend/.env.example)
